{
  "name": "eventsync-platform",
  "version": "1.0.0",
  "description": "Professional Campus Event Management & QR Analytics Platform for SLIIT",
  "main": "server/index.js",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "server:dev": "cd server && npm run dev",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "clean": "rm -rf server/node_modules client/node_modules node_modules"
  },
  "keywords": [
    "event-management",
    "campus-events",
    "qr-analytics",
    "slight",
    "react",
    "express",
    "mongodb",
    "professional"
  ],
  "author": "EventSync Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DulharaManawadu/EventSync_SLIIT_EventManagementSystem"
  }
}
